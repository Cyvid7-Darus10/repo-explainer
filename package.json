{
  "name": "repo-explainer",
  "version": "0.1.0",
  "description": "An agent skill that turns any codebase into a guided, interactive HTML tour: architecture map, step-through end-to-end flows, and a timeline of what changed and why.",
  "type": "module",
  "bin": {
    "repo-explainer": "bin/repo-explainer.mjs"
  },
  "files": [
    "bin/",
    "scripts/lib/",
    "template/",
    "presets/",
    "patterns/",
    "assets/",
    "references/",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:example": "node bin/repo-explainer.mjs build examples/taskflow.explainer.json",
    "build:gallery": "node bin/repo-explainer.mjs gallery --out examples/gallery.html",
    "build:assets": "node bin/repo-explainer.mjs assets --out assets",
    "check": "npm test && npm run build:example && npm run build:gallery"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "agent-skill",
    "claude-code",
    "codebase",
    "architecture",
    "onboarding",
    "documentation",
    "sequence-diagram",
    "developer-experience"
  ],
  "license": "MIT",
  "author": "Cyrus David Pastelero",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cyvid7-Darus10/repo-explainer.git"
  },
  "bugs": {
    "url": "https://github.com/Cyvid7-Darus10/repo-explainer/issues"
  },
  "homepage": "https://github.com/Cyvid7-Darus10/repo-explainer#readme"
}
